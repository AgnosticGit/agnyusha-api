# TLS via Let's Encrypt — DNS A for DOMAIN and www → VPS IP required.
# Set DOMAIN=agnyusha.ru in .env, then: docker compose up -d caddy

{$DOMAIN}, www.{$DOMAIN} {
	encode gzip zstd

	handle /api* {
		reverse_proxy api:3001
	}

	handle /uploads* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}
}
