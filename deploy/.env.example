# /opt/agnyusha/.env — never commit real secrets.
# Non-secrets below are applied to the server .env on each API deploy.
# Secrets (empty / CHANGE_ME here) come from GitHub Actions repository secrets.

# --- Stack ---
DOMAIN=agnyusha.ru
PUBLIC_BASE_URL=https://agnyusha.ru
CORS_ORIGIN=https://agnyusha.ru
PUBLIC_WEB_URL=https://agnyusha.ru

POSTGRES_USER=agnyusha
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=agnyusha

API_IMAGE=ghcr.io/agnosticgit/agnyusha-api:latest
WEB_IMAGE=ghcr.io/agnosticgit/agnyusha-web:latest

# --- API ---
NODE_ENV=production
PORT=3001
# Per-IP sliding window (requests per minute) on /api/*
# API_IP_LIMIT=120
# CITIES_SEARCH_IP_LIMIT=30
# ORDERS_WRITE_IP_LIMIT=10
MAGIC_LINK_EXPIRES_MINUTES=15
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Host metrics (admin/health). Compose mounts /proc and / to these paths.
HOST_PROC_PATH=/host/proc
HOST_ROOT_PATH=/host/root

MAIL_DRIVER=resend
MAIL_FROM=Agnyusha <noreply@agnyusha.ru>
RESEND_API_KEY=

GOOGLE_CLIENT_ID=102499181644-qh2g2o98p8bftskrfdadpksl2i6ofrjk.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://agnyusha.ru/api/auth/google/callback

# CDEK
CDEK_API_URL=https://api.cdek.ru
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_FROM_LOCATION=SPB36
CDEK_TARIFF_CODE=136

# Yandex NDD — PLATFORM_STATION_ID = ПВЗ/СЦ сдачи (не склад с забором)
YANDEX_DELIVERY_API_URL=https://b2b-authproxy.taxi.yandex.net
YANDEX_DELIVERY_TOKEN=
YANDEX_PLATFORM_STATION_ID=01a08c8c3dfc7193bfa73347fbb33727

# Pochta
POCHTA_API_URL=https://otpravka-api.pochta.ru
POCHTA_ACCESS_TOKEN=
POCHTA_AUTHORIZATION_KEY=
POCHTA_MAIL_TYPE=ONLINE_PARCEL
POCHTA_MAIL_CATEGORY=ORDINARY
POCHTA_MAIL_DIRECT=643
POCHTA_FROM_INDEX=195213

# Ozon Pay
OZON_PAY_API_URL=https://payapi.ozon.ru/v1
OZON_PAY_ACCESS_KEY=
OZON_PAY_NOTIFICATION_SECRET=

# Ozon Delivery
OZON_DELIVERY_API_URL=https://api-delivery.ozon.ru
OZON_DELIVERY_TOKEN_URL=https://xapi.ozon.ru/oauth/token
OZON_DELIVERY_CLIENT_ID=
OZON_DELIVERY_CLIENT_SECRET=
OZON_DELIVERY_SHIPMENT_METHOD_ID=1020005000495871

# Sentry (API). Prefer a dedicated Sentry project for the API.
SENTRY_DSN=https://abdf9820642a928dceb176acf0a2e999@o4512090775552000.ingest.de.sentry.io/4512090780729424
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Web also needs NEXT_PUBLIC_SENTRY_DSN at image build time for client errors.
# NEXT_PUBLIC_SENTRY_DSN=
