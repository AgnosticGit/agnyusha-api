# /opt/agnyusha/.env — never commit real values.
# GitHub Actions can upsert selected keys on deploy (see README).

# --- Stack ---
DOMAIN=
# Until DNS/TLS: leave DOMAIN empty and keep HTTP Caddyfile.
PUBLIC_BASE_URL=http://89.111.171.128
CORS_ORIGIN=http://89.111.171.128
PUBLIC_WEB_URL=http://89.111.171.128

POSTGRES_USER=agnyusha
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=agnyusha
# DATABASE_URL is injected by compose from POSTGRES_* (do not set manually unless you know why)

API_IMAGE=ghcr.io/agnosticgit/agnyusha-api:latest
WEB_IMAGE=ghcr.io/agnosticgit/agnyusha-web:latest

# --- API ---
NODE_ENV=production
PORT=3001
INVENTORY_ENABLED=false
MAGIC_LINK_EXPIRES_MINUTES=15
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

MAIL_DRIVER=resend
MAIL_FROM=Agnyusha <onboarding@resend.dev>
RESEND_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://89.111.171.128/api/auth/google/callback

# CDEK
CDEK_API_URL=https://api.cdek.ru
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_FROM_LOCATION=
CDEK_TARIFF_CODE=136
# CDEK_FROM_CITY_CODE=

# Yandex NDD
YANDEX_DELIVERY_API_URL=https://b2b-authproxy.taxi.yandex.net
YANDEX_DELIVERY_TOKEN=
YANDEX_PLATFORM_STATION_ID=

# Pochta
POCHTA_API_URL=https://otpravka-api.pochta.ru
POCHTA_ACCESS_TOKEN=
POCHTA_AUTHORIZATION_KEY=
POCHTA_MAIL_TYPE=ONLINE_PARCEL
POCHTA_MAIL_CATEGORY=ORDINARY
POCHTA_MAIL_DIRECT=643
POCHTA_FROM_INDEX=

# Ozon Pay
OZON_PAY_API_URL=https://payapi.ozon.ru/v1
OZON_PAY_ACCESS_KEY=
OZON_PAY_NOTIFICATION_SECRET=

# Ozon Delivery
OZON_DELIVERY_API_URL=https://api-delivery.ozon.ru
OZON_DELIVERY_TOKEN_URL=https://xapi.ozon.ru/oauth/token
OZON_DELIVERY_CLIENT_ID=
OZON_DELIVERY_CLIENT_SECRET=
OZON_DELIVERY_SHIPMENT_METHOD_ID=
