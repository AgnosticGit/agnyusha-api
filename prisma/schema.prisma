generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeliveryMethodCode {
  PICKUP
  COURIER
  CDEK
  YANDEX
  POST
}

enum UserRole {
  USER
  STAFF
  MANAGER
  ADMIN
}

enum StaffPermission {
  PRODUCT_CREATE
  PRODUCT_DELETE
  PRODUCT_EDIT
  PRODUCT_STOCK
  ORDER_MANAGE
}

enum ProductCategory {
  DOGS
  CATS
}

enum ProductBadge {
  NONE
  HIT
  NEW
  SALE
}

enum OrderStatus {
  NEW
  PAID
  CONFIRMED
  SHIPPED
  DONE
  CANCELLED
  /// Carrier shipment gone (CDEK 404 / purged) — stop tracking, not a success/cancel.
  ARCHIVED
}

model DeliveryMethod {
  id          String             @id @default(cuid())
  code        DeliveryMethodCode @unique
  title       String
  description String
  sortOrder   Int                @default(0) @map("sort_order")
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")

  @@map("delivery_methods")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  /// Set when the user completes magic-link or Google login.
  emailVerifiedAt DateTime?        @map("email_verified_at")
  phone           String           @default("")
  lastName        String           @default("") @map("last_name")
  firstName       String           @default("") @map("first_name")
  middleName      String           @default("") @map("middle_name")
  role            UserRole         @default(USER)
  bannedAt        DateTime?        @map("banned_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  magicLinks      MagicLink[]
  sessions        Session[]
  orders          Order[]
  permissions     UserPermission[]
  cart            Cart?

  @@map("users")
}

model UserPermission {
  userId     String          @map("user_id")
  permission StaffPermission
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@map("user_permissions")
}

model MagicLink {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, createdAt])
  @@map("magic_links")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  subtitle         String           @default("")
  image            String
  images           String[]         @default([])
  category         ProductCategory
  badge            ProductBadge     @default(NONE)
  badgeLabel       String           @default("") @map("badge_label")
  badgeColor       String           @default("") @map("badge_color")
  discountPercent  Int?             @map("discount_percent")
  ingredients      String           @default("")
  description      String           @default("")
  nutritionProtein Float?           @map("nutrition_protein")
  nutritionFat     Float?           @map("nutrition_fat")
  nutritionCarbs   Float?           @map("nutrition_carbs")
  sortOrder        Int              @default(0) @map("sort_order")
  isActive         Boolean          @default(true) @map("is_active")
  /// Curated homepage “Популярные товары” — only via admin checkbox.
  isPopular        Boolean          @default(false) @map("is_popular")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  variants         ProductVariant[]
  orderItems       OrderItem[]

  @@index([category, isActive, sortOrder])
  @@index([isPopular, isActive, sortOrder])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  sku         String   @unique
  weight      String
  /// Real package weight for shipping (grams).
  weightGrams Int      @map("weight_grams")
  price       Float
  stock       Int      @default(0)
  sortOrder   Int      @default(0) @map("sort_order")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  cartItems   CartItem[]

  @@index([productId, sortOrder])
  @@map("product_variants")
}

model Cart {
  id             String     @id @default(cuid())
  userId         String?    @unique @map("user_id")
  guestTokenHash String?    @unique @map("guest_token_hash")
  expiresAt      DateTime?  @map("expires_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CartItem[]

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String         @map("cart_id")
  variantId String         @map("variant_id")
  qty       Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id                   String      @id @default(cuid())
  userId               String?     @map("user_id")
  status               OrderStatus @default(NEW)
  email                String
  phone                String
  lastName             String      @map("last_name")
  firstName            String      @map("first_name")
  middleName           String      @default("") @map("middle_name")
  contactChannel       String      @map("contact_channel")
  cityLabel            String      @map("city_label")
  deliveryCode         String      @map("delivery_code")
  deliveryTitle        String      @map("delivery_title")
  pickupLabel          String?     @map("pickup_label")
  pickupCode           String?     @map("pickup_code")
  externalDeliveryId   String?     @map("external_delivery_id")
  deliveryTrackNumber  String?     @map("delivery_track_number")
  deliveryStatusCode   String?     @map("delivery_status_code")
  deliveryStatusLabel  String?     @map("delivery_status_label")
  deliveryTrackingUrl  String?     @map("delivery_tracking_url")
  deliveryStatusAt     DateTime?   @map("delivery_status_at")
  paymentExternalId    String?     @map("payment_external_id")
  paymentPayLink       String?     @map("payment_pay_link")
  paidAt               DateTime?   @map("paid_at")
  total                Float
  createdAt            DateTime    @default(now()) @map("created_at")
  user                 User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                OrderItem[]

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([email])
  @@map("orders")
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String          @map("order_id")
  productId   String?         @map("product_id")
  variantId   String?         @map("variant_id")
  productName String          @map("product_name")
  image       String
  weight      String
  /// Snapshot of variant shipping weight (grams) at order time.
  weightGrams Int             @map("weight_grams")
  price       Float
  qty         Int
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("order_items")
}
