# Copy to `.env.development` (npm run dev) or `.env.production` (prod / ngrok).
# Nest loads only `.env.${NODE_ENV}` — there is no shared `.env`.

NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://agnyusha:agnyusha@localhost:5433/agnyusha?schema=public

CORS_ORIGIN=http://localhost:3000
# Public storefront URL for redirects / magic links / Ozon success|fail|notify.
# Defaults to first CORS_ORIGIN if empty.
PUBLIC_WEB_URL=http://localhost:3000

# CDEK — тестовый контур по умолчанию
# Документация: https://apidoc.cdek.ru/
# Account / Secure password из кабинета интегратора СДЭК (не логин ЛК)
CDEK_API_URL=https://api.cdek.ru
CDEK_CLIENT_ID=your_cdek_account
CDEK_CLIENT_SECRET=your_cdek_secure_password
# Код ПВЗ/склада сдачи (shipment_point) для создания заказов (edu: например MSK65)
CDEK_FROM_LOCATION=SPB36
CDEK_TARIFF_CODE=136

# Yandex Delivery NDD (токен из кабинета: Интеграция)
# Docs: https://yandex.ru/support/delivery-profile/ru/api/other-day/access
# Тест: https://b2b.taxi.tst.yandex.net
# Прод: https://b2b-authproxy.taxi.yandex.net
YANDEX_DELIVERY_API_URL=https://b2b-authproxy.taxi.yandex.net
YANDEX_DELIVERY_TOKEN=your_yandex_bearer_token
# Станция отгрузки (source) — ПВЗ/СЦ, куда вы сдаёте посылки (не ПВЗ покупателя).
# ID выдаёт менеджер Яндекс Доставки под «сдачу в ПВЗ».
# В offers/create уходит как source.platform_station + interval_utc (готовность к сдаче).
YANDEX_PLATFORM_STATION_ID=ce922069-ff21-45e0-be65-a7eef758cba4

# Почта России Otpravka API (токен + ключ из otpravka.pochta.ru)
# Docs: https://otpravka.pochta.ru/specification
POCHTA_API_URL=https://otpravka-api.pochta.ru
POCHTA_ACCESS_TOKEN=
# Уже Base64(login:password) — без префикса Basic
POCHTA_AUTHORIZATION_KEY=
POCHTA_MAIL_TYPE=ONLINE_PARCEL
POCHTA_MAIL_CATEGORY=ORDINARY
# ISO 3166-1 numeric country (643 = Россия). Обязателен для backlog.
POCHTA_MAIL_DIRECT=643
# Индекс ОПС / точки сдачи отправителя
POCHTA_FROM_INDEX=195213
# Код объекта тарификатора (fallback ETA). ONLINE_PARCEL → 23030
# POCHTA_TARIFF_OBJECT=23030

# Auth / email (Resend)
# from: только ASCII в имени; адрес на верифицированном домене
MAIL_DRIVER=resend
MAIL_FROM=Agnyusha <noreply@agnyusha.ru>
RESEND_API_KEY=
MAGIC_LINK_EXPIRES_MINUTES=15

# Google OAuth (callback must hit the API host so the session cookie is set)
GOOGLE_CLIENT_ID=102499181644-qh2g2o98p8bftskrfdadpksl2i6ofrjk.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Ozon Delivery for Business (private app type Delivery API)
# Docs: https://docs.ozon.ru/api/ozon-delivery/
OZON_DELIVERY_API_URL=https://api-delivery.ozon.ru
OZON_DELIVERY_TOKEN_URL=https://xapi.ozon.ru/oauth/token
OZON_DELIVERY_CLIENT_ID=
OZON_DELIVERY_CLIENT_SECRET=
# ID способа отгрузки из кабинета Ozon Delivery
OZON_DELIVERY_SHIPMENT_METHOD_ID=1020005000495871
# Optional comma-separated scopes (default: delivery-api.all)
# OZON_DELIVERY_SCOPES=delivery-api.all
# Optional cap when building PVZ index (pages × 100 points)
# OZON_DELIVERY_INDEX_MAX_PAGES=300

# Ozon Pay (test token works the same as prod — only cabinet mode differs)
# Docs host: https://payapi.ozon.ru/v1
# Cabinet URLs (use public host of the web app):
# Success: https://<host>/payment/success
# Fail:    https://<host>/payment/fail
# Notify:  https://<host>/api/payments/ozon/webhook
OZON_PAY_API_URL=https://payapi.ozon.ru/v1
OZON_PAY_ACCESS_KEY=
OZON_PAY_NOTIFICATION_SECRET=

# Optional overrides (have code defaults — usually leave unset):
# COOKIE_SECURE=true|false
# COOKIE_SAMESITE=lax|none|strict
# MAGIC_LINK_IP_LIMIT=20
# NGROK_DOMAIN=your-domain.ngrok-free.dev

# Sentry error monitoring (https://sentry.io). Empty = disabled.
# Enabled only when NODE_ENV=production (see isSentryEnabled).
SENTRY_DSN=
# Optional override (0..1). Default in production: 0.1
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Background delivery tracking poll (CDEK / Yandex / Pochta).
# INTERVAL — how often each order is checked (minutes). 0 disables that carrier.
# GAP — min pause between API calls to that carrier (milliseconds).
# Defaults: 60 min / 2500 ms. See documentation/opros-statusov-dostavki.md
# CDEK_POLL_INTERVAL_MIN=60
# CDEK_POLL_GAP_MS=2500
# YANDEX_POLL_INTERVAL_MIN=60
# YANDEX_POLL_GAP_MS=2500
# POCHTA_POLL_INTERVAL_MIN=60
# POCHTA_POLL_GAP_MS=2500
NEW_FEATURE_FLAG=1